<%- include('../cabecalho')%>

    <div>
        <tr><a href="/paleontologo"> ← Voltar </a></tr>
        <h3>Novo Paleontólogo</h3>

        <form method="post">
            <p>ID </p>
            <input type="id" name="id" value="<%=paleontologo.id%>" readonly>
            <br><br>
            <p>Nome</p>
            <input type="text" name="nome" value="<%=paleontologo.nome%>">
            <p>Nascimento</p>
            <input type="text" name="nascimento" value="<%=paleontologo.nascimento%>">
            <br>

            <p>Descoberta</p>
            <textarea type="text" name="Descoberta" value="<%=paleontologo.Descoberta%>">"></textarea>
            <br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>

        </form>

    </div>
    </body>

    </html>